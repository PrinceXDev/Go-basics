# Copy to .env and adjust. Never commit the real .env.
POSTGRES_USER=ratelimit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ratelimit
POSTGRES_PORT=5432

# Used by the Go app
DATABASE_URL=postgres://ratelimit:change_me@localhost:5432/ratelimit?sslmode=disable
HTTP_ADDR=:8080

# Fixed window length, Go duration format (30s, 1m, 1h)
RATE_LIMIT_WINDOW=1m
# Max requests per window for each scope
RATE_LIMIT_TENANT=100
RATE_LIMIT_API_KEY=40
RATE_LIMIT_USER=20

# What to do when the database is unreachable: true = allow requests, false = reject (503)
RATE_LIMIT_FAIL_OPEN=true

# Fault tolerance (see docs: timeout -> retry -> circuit breaker -> fail-open)
DB_TIMEOUT=200ms
DB_RETRY_ATTEMPTS=3
DB_RETRY_BACKOFF=20ms
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN=10s
