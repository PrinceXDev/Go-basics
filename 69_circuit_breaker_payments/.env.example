# PostgreSQL connection. Default matches `go run ./cmd/devpg` and docker-compose.yml.
DATABASE_URL=postgres://cbpay:cbpay@localhost:5433/cbpay?sslmode=disable
# Our payment API.
HTTP_ADDR=:8080
# Where the fake external gateway listens, and the URL our client uses to reach it.
GATEWAY_ADDR=:8090
GATEWAY_URL=http://localhost:8090
# Used by the Next.js server to proxy /api/* to the Go API.
API_URL=http://localhost:8080
