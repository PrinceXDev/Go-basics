HTTP_ADDR=:8080
METRICS_ADDR=:9101
DATABASE_URL=postgres://user:password@localhost:5432/adclick?sslmode=disable
KAFKA_BROKERS=localhost:9092
TOPIC_EVENTS=ad-click-events
TOPIC_RETRY=ad-click-retry
TOPIC_DLQ=ad-click-dlq
CONSUMER_GROUP=click-aggregators
TOPIC_PARTITIONS=12
REPLICATION_FACTOR=1
IP_HASH_SALT=change_me
CONSUMER_CONCURRENCY=2
BATCH_SIZE=500
MAX_RETRIES=3
RETRY_DELAY=5s
DEDUP_RETENTION=192h
MAX_EVENT_AGE=168h
MAX_FUTURE_SKEW=5m
AD_CACHE_REFRESH=30s
LOG_LEVEL=info
