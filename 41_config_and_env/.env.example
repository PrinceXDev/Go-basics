# Copy to .env for local development. NEVER commit the real .env.
# (The stdlib does not read .env files — add github.com/joho/godotenv
#  in main() for local dev if you want that.)

APP_ENV=dev                 # dev | staging | prod
APP_LOG_LEVEL=info          # debug | info | warn | error

APP_HOST=127.0.0.1
APP_PORT=8080
APP_READ_TIMEOUT=10s        # any time.ParseDuration value: 30s, 5m, 1h30m

APP_DB_DSN=postgres://user:password@localhost:5432/dbname?sslmode=disable
APP_DB_MAX_CONNS=25

APP_ENABLE_SIGNUP=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1
